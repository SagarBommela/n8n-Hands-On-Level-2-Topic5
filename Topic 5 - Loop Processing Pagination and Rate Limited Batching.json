    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nconst totalUsers =\n  (staticData.accumulatedUsers || []).length;\n\nreturn [{\n  json: {\n    pipelineSummary: \"BATCH_PAGINATION_COMPLETE\",\n    totalPagesHarvested: staticData.currentPage - 1,\n    totalUsersProcessed: totalUsers,\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
