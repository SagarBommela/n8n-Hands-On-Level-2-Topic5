      ],
      "id": "af1d2567-1f55-45ae-90e3-bc626ad62c53",
      "name": "IF_HasMorePages"
    },
    {
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\n\n// Initialize values if they are undefined\nif (!Array.isArray(staticData.accumulatedUsers)) {\n  staticData.accumulatedUsers = [];\n}\n\nif (typeof staticData.currentPage !== 'number') {\n  staticData.currentPage = 1;\n}\n\n// Get API response\nconst inputData = $input.first().json;\n\nconst newItems = Array.isArray(inputData.items)\n  ? inputData.items\n  : $input.all().map(i => i.json);\n\n// Accumulate users\nstaticData.accumulatedUsers =\n  staticData.accumulatedUsers.concat(newItems);\n\n// Increment page\nstaticData.currentPage += 1;\n\n// Get maximum pages\nconst maxPages =\n  $node['Set_Config'].json.maxPages || 10;\n\nconst hasHitMax = staticData.currentPage > maxPages;\n\n// Return output\nreturn [{\n  json: {\n    currentPage: staticData.currentPage,\n    totalAccumulatedSoFar:\n      staticData.accumulatedUsers.length,\n    shouldContinue:\n      !hasHitMax && newItems.length > 0\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -80
      ],
      "id": "3991d636-4b9c-42ac-8e61-ea8b74bdc10e",
      "name": "Code_AccumulatePage"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nconst users = staticData.accumulatedUsers || [];\n\nreturn users.map(user => ({\n  json: user\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        80
      ],
      "id": "6420a89a-ccf0-49aa-8389-438015ebf609",
